{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-compiled-workcell/16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "frontier_id", "cell_id", "kind", "base_head", "dependencies", "objective",
    "acceptance", "conflict_class", "resource_claims", "requirement_ids", "target",
    "positive_verification", "negative_verification", "rollback", "consumer",
    "context_manifest_ref", "result_contract", "context_receipt_contract", "adjudication_contract",
    "session_reuse_policy", "return_contract"
  ],
  "properties": {
    "schema": {"const": "flyby/mission-control-compiled-workcell/16"},
    "frontier_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
    "cell_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
    "kind": {"enum": ["AUDIT", "MUTATION", "INTEGRATION", "QUALIFICATION"]},
    "base_head": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}},
    "objective": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conflict_class": {"type": "string", "minLength": 1},
    "resource_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}},
    "target": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "base_sha", "owned_paths"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "positive_verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "negative_verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": ["string", "null"]},
    "consumer": {"type": ["string", "null"]},
    "context_manifest_ref": {"type": "string", "pattern": "^frontiers/[A-Z][A-Z0-9_-]*/contexts/[A-Z][A-Z0-9_-]*\\.json$"},
    "result_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_sha256"],
      "properties": {
        "schema_ref": {"const": "contracts/schemas/RESULT_SCHEMA.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "context_receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_sha256"],
      "properties": {
        "schema_ref": {"const": "contracts/schemas/CONTEXT_RECEIPT_SCHEMA.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "adjudication_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_sha256"],
      "properties": {
        "schema_ref": {"const": "contracts/schemas/ADJUDICATION_SCHEMA.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "session_reuse_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fresh_only_requires_reason"],
      "properties": {
        "mode": {"enum": ["REUSE_IF_RECEIPT_MATCHES", "FRESH_ONLY"]},
        "fresh_only_requires_reason": {"const": true}
      }
    },
    "return_contract": {"const": ["result.json", "context_receipt.json", "STOP_CELL_NOT_SESSION"]}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "MUTATION"}}},
      "then": {
        "properties": {
          "requirement_ids": {"type": "array", "minItems": 1},
          "target": {"type": "object"},
          "positive_verification": {"type": "array", "minItems": 1},
          "negative_verification": {"type": "array", "minItems": 1},
          "rollback": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "AUDIT"}}},
      "then": {
        "properties": {
          "target": {"type": "null"},
          "requirement_ids": {"const": []}
        }
      }
    }
  ]
}
