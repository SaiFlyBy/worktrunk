{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"flyby/mission-control/execution-state-v2.schema.json",
  "type":"object",
  "additionalProperties":true,
  "required":["schema","program","canonical_topology","barriers","cells","transition_laws","next_transition"],
  "properties":{
    "schema":{"type":"string"},
    "program":{"type":"string"},
    "canonical_topology":{
      "type":"object",
      "required":["ref","schema"],
      "properties":{"ref":{"type":"string"},"schema":{"type":"string"},"law":{"type":"string"}},
      "additionalProperties":true
    },
    "control_base":{"type":"object"},
    "target_base":{"type":"object"},
    "barriers":{
      "type":"object",
      "additionalProperties":{
        "type":"object",
        "required":["state"],
        "properties":{"state":{"type":"string"},"evidence_ref":{"type":"string"},"contract_ref":{"type":"string"}},
        "additionalProperties":true
      }
    },
    "cells":{
      "type":"object",
      "additionalProperties":{
        "type":"object",
        "required":["state"],
        "properties":{"state":{"type":"string"}},
        "additionalProperties":true
      }
    },
    "active_frontier":{
      "type":"object",
      "properties":{
        "id":{"type":"string"},
        "state":{"type":"string"},
        "dispatch_control_base":{"type":"string"},
        "dispatch_topology_schema":{"type":"string"},
        "target_base":{"type":"string"},
        "law":{"type":"string"},
        "terminal_evidence_received":{"type":"boolean"}
      },
      "additionalProperties":true
    },
    "frontier":{
      "type":"object",
      "description":"Optional generic current-frontier projection for missions that track ready/compiled/admitted/running/candidate/accepted sets separately from active-attempt metadata.",
      "properties":{
        "dependency_ready":{"type":"array","items":{"type":"string"}},
        "compiled":{"type":"array","items":{"type":"string"}},
        "admitted":{"type":"array","items":{"type":"string"}},
        "running":{"type":"array","items":{"type":"string"}},
        "candidate":{"type":"array","items":{"type":"string"}},
        "accepted":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":true
    },
    "transition_laws":{"type":"array","minItems":1,"items":{"type":"string"}},
    "next_transition":{"type":"string"}
  }
}
