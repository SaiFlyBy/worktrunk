{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-specification-contract/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mission_id", "spec_id", "state", "owner_intent_refs",
    "behaviors", "invariants", "interfaces", "state_transitions",
    "failure_semantics", "compatibility", "performance_resources",
    "observability", "non_goals", "rejected_alternatives", "open_questions",
    "traceability"
  ],
  "properties": {
    "schema": {"const": "flyby/mission-control-specification-contract/1"},
    "mission_id": {"type": "string", "minLength": 1},
    "spec_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["DRAFT", "FROZEN", "AMENDED", "SUPERSEDED"]},
    "owner_intent_refs": {"$ref": "#/$defs/string_set"},
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "behavior_id", "requirement_ids", "statement", "positive_scenarios",
          "negative_scenarios", "boundary_cases", "effects", "authority",
          "acceptance_ids"
        ],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "requirement_ids": {"$ref": "#/$defs/string_set"},
          "statement": {"type": "string", "minLength": 1},
          "positive_scenarios": {"$ref": "#/$defs/string_set"},
          "negative_scenarios": {"$ref": "#/$defs/string_set"},
          "boundary_cases": {"$ref": "#/$defs/string_set"},
          "effects": {"$ref": "#/$defs/string_set"},
          "authority": {"type": "string", "minLength": 1},
          "acceptance_ids": {"$ref": "#/$defs/string_set"}
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "statement", "scope", "violation_behavior", "verification_ids"],
        "properties": {
          "invariant_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "scope": {"$ref": "#/$defs/string_set"},
          "violation_behavior": {"type": "string", "minLength": 1},
          "verification_ids": {"$ref": "#/$defs/string_set"}
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interface_id", "inputs", "outputs", "effects", "errors", "compatibility_surface"],
        "properties": {
          "interface_id": {"type": "string", "minLength": 1},
          "inputs": {"$ref": "#/$defs/string_set"},
          "outputs": {"$ref": "#/$defs/string_set"},
          "effects": {"$ref": "#/$defs/string_set"},
          "errors": {"$ref": "#/$defs/string_set"},
          "compatibility_surface": {"$ref": "#/$defs/string_set"}
        }
      }
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition_id", "from", "trigger", "guards", "to", "effects", "idempotency"],
        "properties": {
          "transition_id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "guards": {"$ref": "#/$defs/string_set"},
          "to": {"type": "string", "minLength": 1},
          "effects": {"$ref": "#/$defs/string_set"},
          "idempotency": {"type": "string", "minLength": 1}
        }
      }
    },
    "failure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_modes", "retry", "cancellation", "recovery", "rollback", "partial_success"],
      "properties": {
        "failure_modes": {"$ref": "#/$defs/string_set"},
        "retry": {"type": "string"},
        "cancellation": {"type": "string"},
        "recovery": {"type": "string"},
        "rollback": {"type": "string"},
        "partial_success": {"type": "string"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve", "migration", "breaking_change_policy"],
      "properties": {
        "preserve": {"$ref": "#/$defs/string_set"},
        "migration": {"$ref": "#/$defs/string_set"},
        "breaking_change_policy": {"type": "string", "minLength": 1}
      }
    },
    "performance_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "targets", "calibration_method"],
      "properties": {
        "dimensions": {"$ref": "#/$defs/string_set"},
        "targets": {"$ref": "#/$defs/string_set"},
        "calibration_method": {"type": "string", "minLength": 1}
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals", "diagnostics", "auditability"],
      "properties": {
        "signals": {"$ref": "#/$defs/string_set"},
        "diagnostics": {"$ref": "#/$defs/string_set"},
        "auditability": {"$ref": "#/$defs/string_set"}
      }
    },
    "non_goals": {"$ref": "#/$defs/string_set"},
    "rejected_alternatives": {"$ref": "#/$defs/string_set"},
    "open_questions": {"$ref": "#/$defs/string_set"},
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior_id", "mechanism_ids", "requirement_ids", "verification_ids"],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "mechanism_ids": {"$ref": "#/$defs/string_set"},
          "requirement_ids": {"$ref": "#/$defs/string_set"},
          "verification_ids": {"$ref": "#/$defs/string_set"}
        }
      }
    }
  },
  "$defs": {
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
