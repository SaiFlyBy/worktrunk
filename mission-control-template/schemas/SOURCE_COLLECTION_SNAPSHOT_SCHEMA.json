{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-source-collection-snapshot/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mission_id", "collection_id", "kind", "locator", "observed_at",
    "retrieval", "items", "item_count", "items_sha256", "frozen"
  ],
  "properties": {
    "schema": {"const": "flyby/mission-control-source-collection-snapshot/1"},
    "mission_id": {"type": "string", "minLength": 1},
    "collection_id": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["GITHUB_STAR_LIST", "GITHUB_TOPIC", "MANIFEST", "EXPLICIT_LIST", "OTHER"]
    },
    "locator": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "pagination_or_cursors", "reported_total", "raw_evidence",
        "completeness_assertion"
      ],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "pagination_or_cursors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "reported_total": {"type": ["integer", "null"], "minimum": 0},
        "raw_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "ref", "sha256"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "completeness_assertion": {"type": "string", "minLength": 1}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "source_locator", "snapshot_revision", "membership_evidence_id"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "snapshot_revision": {"type": "string", "minLength": 1},
          "membership_evidence_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "item_count": {"type": "integer", "minimum": 0},
    "items_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen": {"type": "boolean"}
  }
}
