{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-mission/16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "control_repository",
    "authoritative_working_branch",
    "target_repositories",
    "previous_mission_handoff",
    "previous_mission_handoff_sha256",
    "owner_intent",
    "hard_boundaries"
  ],
  "properties": {
    "schema": {"const": "flyby/mission-control-mission/16"},
    "mission_id": {"type": "string", "minLength": 1},
    "control_repository": {"type": "string", "minLength": 3},
    "authoritative_working_branch": {"type": "string", "minLength": 1},
    "target_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "baseline_sha"],
        "properties": {
          "repository": {"type": "string", "minLength": 3},
          "baseline_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
        }
      }
    },
    "previous_mission_handoff": {"type": ["string", "null"]},
    "previous_mission_handoff_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "owner_intent": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hard_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
