{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-target-corpus/17",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "provenance_materialization",
    "requirements"
  ],
  "properties": {
    "schema": {
      "const": "flyby/mission-control-target-corpus/17"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sources",
          "targets",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "authority"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "mechanisms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "derivation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owned_abstraction",
              "combines_with",
              "preserves",
              "non_goals",
              "verification_strategy",
              "copyright_posture"
            ],
            "properties": {
              "owned_abstraction": {
                "type": "string",
                "minLength": 1
              },
              "combines_with": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "preserves": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "non_goals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verification_strategy": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "copyright_posture": {
                "enum": [
                  "OWNER_AUTHORIZED_REUSE",
                  "LICENSE_PERMITTED_REUSE",
                  "CLEAN_ROOM_BEHAVIORAL_SYNTHESIS",
                  "MIXED_RIGHTS_AWARE_SYNTHESIS"
                ]
              }
            }
          }
        }
      }
    },
    "provenance_materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "target_refs",
        "coverage_requirement_id",
        "validation_schema_ref",
        "authority",
        "acceptance"
      ],
      "properties": {
        "mode": {
          "enum": [
            "REQUIRED_EXISTING_TARGET_MANIFEST",
            "REQUIRED_NEW_TARGET_MANIFEST",
            "TARGET_HAS_NO_LINEAGE_MANIFEST",
            "SAME_REPOSITORY_NO_NEW_HARVEST"
          ]
        },
        "target_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverage_requirement_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "const": "LINEAGE_ONLY"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_schema_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "preservation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "policy_base_sha",
            "protected_files"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "policy_base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "protected_files": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "path",
                  "mode",
                  "git_blob",
                  "sha256"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "LINEAGE",
                      "HARVEST",
                      "POLICY",
                      "VALIDATOR"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "git_blob": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
