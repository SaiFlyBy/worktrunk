{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-cell/16",
  "type": "object",
  "additionalProperties": false,
  "required": ["cell_id", "kind", "dependencies", "objective", "acceptance", "status", "conflict_class", "resource_claims"],
  "properties": {
    "cell_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_-]*$"},
    "kind": {"enum": ["AUDIT", "MUTATION", "INTEGRATION", "QUALIFICATION", "BARRIER"]},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "objective": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"const": "PENDING"},
    "conflict_class": {"type": "string", "minLength": 1},
    "resource_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_-]*$"}},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_sha", "owned_paths"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "owned_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "positive_verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "negative_verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "string"},
    "consumer": {"type": "string"},
    "result_schema": {"const": "contracts/schemas/RESULT_SCHEMA.json"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "AUDIT"}}},
      "then": {
        "required": ["consumer", "result_schema"],
        "properties": {
          "requirement_ids": {"type": "null"},
          "target": {"type": "null"},
          "positive_verification": {"type": "null"},
          "negative_verification": {"type": "null"},
          "rollback": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "MUTATION"}}},
      "then": {
        "required": ["requirement_ids", "target", "positive_verification", "negative_verification", "rollback", "result_schema"],
        "properties": {"consumer": {"type": "null"}}
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["INTEGRATION", "QUALIFICATION"]}}},
      "then": {
        "required": ["result_schema"],
        "properties": {
          "requirement_ids": {"type": "null"},
          "target": {"type": "null"},
          "positive_verification": {"type": "null"},
          "negative_verification": {"type": "null"},
          "rollback": {"type": "null"},
          "consumer": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "BARRIER"}}},
      "then": {
        "properties": {
          "requirement_ids": {"type": "null"},
          "target": {"type": "null"},
          "positive_verification": {"type": "null"},
          "negative_verification": {"type": "null"},
          "rollback": {"type": "null"},
          "consumer": {"type": "null"},
          "result_schema": {"type": "null"}
        }
      }
    }
  ]
}
