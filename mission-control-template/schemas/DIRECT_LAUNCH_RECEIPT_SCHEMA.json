{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-direct-launch-receipt/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "source_ref",
    "target_base",
    "generation",
    "provider",
    "model",
    "reasoning_effort",
    "approval_policy",
    "sandbox_policy",
    "execution_custody",
    "child_thread_created",
    "delegation_used",
    "launch_api",
    "assigned_thread_id",
    "turn_1_prompt_ref",
    "turn_1_prompt_sha256",
    "session_birth_evidence_ref",
    "session_birth_evidence_sha256",
    "launch_observed_at",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "enum": [
        "flyby/mcv6-direct-launch-receipt/1",
        "flyby/mission-control-direct-launch-receipt/1"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_base": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "provider": {
      "enum": [
        "mailbox.codex",
        "mailbox.wslcodex"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "type": "string",
      "minLength": 1
    },
    "approval_policy": {
      "const": "never"
    },
    "sandbox_policy": {
      "const": "danger-full-access"
    },
    "execution_custody": {
      "const": "DIRECT_TOP_LEVEL_SESSION"
    },
    "child_thread_created": {
      "const": false
    },
    "delegation_used": {
      "const": false
    },
    "launch_api": {
      "enum": [
        "mailbox.codex.start",
        "mailbox.wslcodex.start"
      ]
    },
    "assigned_thread_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_1_prompt_ref": {
      "type": "string",
      "minLength": 1
    },
    "turn_1_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "session_birth_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "session_birth_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "launch_observed_at": {
      "type": "string",
      "minLength": 1
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
