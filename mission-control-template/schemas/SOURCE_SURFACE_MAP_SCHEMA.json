{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-source-surface-map/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mission_id", "source_id", "source_identity", "source_version",
    "root_inventory_sha256", "partitions", "auxiliary_surfaces", "open_questions",
    "rights_status", "coverage_status"
  ],
  "properties": {
    "schema": {"const": "flyby/mission-control-source-surface-map/1"},
    "mission_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_identity": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "root_inventory_ref": {"type": ["string", "null"]},
    "root_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rights_status": {"enum": ["RESOLVED", "UNRESOLVED", "BLOCKED"]},
    "coverage_status": {"enum": ["DISCOVERING", "IN_PROGRESS", "EXHAUSTED", "BLOCKED"]},
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partition_id", "locator", "kind", "criticality", "status",
          "coverage_evidence", "mechanism_ids", "exclusion_reason"
        ],
        "properties": {
          "partition_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "SOURCE", "ARCHITECTURE", "API_CONTRACT", "RUNTIME", "STATE_STORAGE",
              "TEST", "FUZZ_CONFORMANCE", "BENCHMARK_EVAL", "CI_CD", "PACKAGING_RELEASE",
              "EXAMPLE", "EXTENSION_INTERFACE", "SECURITY", "OBSERVABILITY_RECOVERY",
              "PERFORMANCE_RESOURCE", "LICENSE_NOTICE", "CHANGE_HISTORY", "OTHER"
            ]
          },
          "criticality": {"enum": ["CRITICAL", "MATERIAL", "AUXILIARY"]},
          "status": {
            "enum": [
              "PENDING", "INSPECTING", "INSPECTED", "EXCLUDED_GENERATED",
              "EXCLUDED_VENDOR", "EXCLUDED_BINARY", "EXCLUDED_IRRELEVANT_WITH_RATIONALE", "BLOCKED"
            ]
          },
          "coverage_evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "mechanism_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "exclusion_reason": {"type": ["string", "null"]}
        }
      }
    },
    "auxiliary_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests", "ci_cd", "benchmarks", "examples", "security", "packaging_release",
        "license_notice", "change_history"
      ],
      "properties": {
        "tests": {"$ref": "#/$defs/surface_state"},
        "ci_cd": {"$ref": "#/$defs/surface_state"},
        "benchmarks": {"$ref": "#/$defs/surface_state"},
        "examples": {"$ref": "#/$defs/surface_state"},
        "security": {"$ref": "#/$defs/surface_state"},
        "packaging_release": {"$ref": "#/$defs/surface_state"},
        "license_notice": {"$ref": "#/$defs/surface_state"},
        "change_history": {"$ref": "#/$defs/surface_state"}
      }
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "terminal_receipt_ref": {"type": ["string", "null"]},
    "terminal_receipt_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "surface_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "status", "locators", "notes"],
      "properties": {
        "present": {"type": "boolean"},
        "status": {"enum": ["INSPECTED", "NOT_PRESENT", "PENDING", "BLOCKED"]},
        "locators": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "notes": {"type": "string"}
      }
    }
  }
}
