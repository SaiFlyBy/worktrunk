{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-structural-mutation-plan/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mission_id", "cell_id", "repository", "base_sha",
    "surfaces", "global_preservation", "post_mutation_checks"
  ],
  "properties": {
    "schema": {"const": "flyby/mission-control-structural-mutation-plan/1"},
    "mission_id": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "minLength": 1},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repository": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id", "language_or_format", "owned_paths", "mutation_kind",
          "engine", "engine_identity", "selectors", "expected_affected",
          "expected_unaffected", "excluded_boundaries", "preservation",
          "parse_failure_policy", "text_fallback_rationale", "idempotency"
        ],
        "properties": {
          "surface_id": {"type": "string", "minLength": 1},
          "language_or_format": {"type": "string", "minLength": 1},
          "owned_paths": {"$ref": "#/$defs/nonempty_string_set"},
          "mutation_kind": {
            "enum": [
              "SYMBOL_REFACTOR", "API_CHANGE", "CONFIG_CHANGE", "SCHEMA_CHANGE",
              "DEPENDENCY_CHANGE", "GENERATED_REPROJECTION", "TEXTUAL_CONTENT", "OTHER"
            ]
          },
          "engine": {
            "enum": [
              "COMPILER_AST", "TREE_SITTER", "LANGUAGE_SERVER", "SCHEMA_REWRITER",
              "REFACTORING_ENGINE", "QUERYABLE_IR", "GENERATOR_OWNER",
              "TEXT_ONLY_WITH_JUSTIFICATION", "OTHER_STRUCTURAL"
            ]
          },
          "engine_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version_or_digest", "source_ref"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version_or_digest": {"type": "string", "minLength": 1},
              "source_ref": {"type": "string", "minLength": 1}
            }
          },
          "selectors": {"$ref": "#/$defs/nonempty_string_set"},
          "expected_affected": {"$ref": "#/$defs/nonempty_string_set"},
          "expected_unaffected": {"$ref": "#/$defs/nonempty_string_set"},
          "excluded_boundaries": {"$ref": "#/$defs/string_set"},
          "preservation": {"$ref": "#/$defs/nonempty_string_set"},
          "parse_failure_policy": {"type": "string", "minLength": 1},
          "text_fallback_rationale": {"type": ["string", "null"]},
          "idempotency": {"enum": ["REQUIRED", "INTENTIONALLY_NON_IDEMPOTENT", "NOT_APPLICABLE"]}
        }
      }
    },
    "global_preservation": {"$ref": "#/$defs/nonempty_string_set"},
    "post_mutation_checks": {"$ref": "#/$defs/nonempty_string_set"}
  },
  "$defs": {
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonempty_string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
