{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-source-review-turn-chain-index/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adoption_ref",
    "adoption_sha256",
    "legacy_pre_enforcement",
    "post_enforcement_generations"
  ],
  "properties": {
    "schema": {
      "const": "flyby/source-review-turn-chain-index/2"
    },
    "adoption_ref": {
      "type": "string",
      "minLength": 1
    },
    "adoption_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "legacy_pre_enforcement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_ref",
          "thread_id",
          "generation",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "thread_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "post_enforcement_generations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_ref",
          "thread_id",
          "generation",
          "provider",
          "model",
          "reasoning_effort",
          "rights_mode",
          "execution_custody",
          "critical_partitions",
          "critical_partition_manifest_sha256",
          "turns",
          "state",
          "target_base",
          "launch_receipt_ref",
          "launch_receipt_sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "thread_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "provider": {
            "enum": [
              "mailbox.wslcodex",
              "mailbox.codex"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reasoning_effort": {
            "type": "string",
            "minLength": 1
          },
          "rights_mode": {
            "enum": [
              "OWNER_AUTHORIZED_REUSE",
              "LICENSE_PERMITTED_REUSE",
              "CLEAN_ROOM_BEHAVIORAL_SYNTHESIS"
            ]
          },
          "execution_custody": {
            "const": "DIRECT_TOP_LEVEL_SESSION"
          },
          "critical_partitions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "critical_partition_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "turn_number",
                "ref",
                "sha256"
              ],
              "properties": {
                "turn_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "checkpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checkpoint_sequence",
                "ref",
                "sha256"
              ],
              "properties": {
                "checkpoint_sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "state": {
            "enum": [
              "ACTIVE",
              "CONVERGED",
              "TOMBSTONED"
            ]
          },
          "target_base": {
            "type": "string",
            "minLength": 1
          },
          "launch_receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "launch_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
