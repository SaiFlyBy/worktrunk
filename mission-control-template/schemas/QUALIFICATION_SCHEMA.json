{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-qualification/16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "outcome", "summary", "evidence", "target_outcomes",
    "requirement_accounting", "verification_accounting", "unresolved_defects", "explicit_limitations"
  ],
  "properties": {
    "schema": {"const": "flyby/mission-control-qualification/16"},
    "outcome": {"const": "ACCEPTED"},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1}
        }
      }
    },
    "target_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "baseline_sha", "accepted_head_sha"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "accepted_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "requirement_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "waived"],
      "properties": {
        "accepted": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "waived": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_id", "reason", "authority"],
            "properties": {
              "requirement_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "verification_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "waived", "not_run"],
      "properties": {
        "run": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "waived": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verification", "reason", "authority"],
            "properties": {
              "verification": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "minLength": 1}
            }
          }
        },
        "not_run": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "unresolved_defects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "explicit_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
