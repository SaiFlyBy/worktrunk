{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flyby/mission-control-workspace-reconciliation/16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "scope",
    "control_workspaces",
    "target_repositories",
    "historical_material",
    "closure_ready"
  ],
  "properties": {
    "schema": {
      "const": "flyby/mission-control-workspace-reconciliation/16"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "string",
          "minLength": 1
        },
        "excluded": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "control_workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_id",
          "disposition",
          "evidence"
        ],
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "worktree_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "dirty": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "semantic_status_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "disposition": {
            "enum": [
              "CANONICAL",
              "SUPERSEDED",
              "TEMPORARY_RECONCILED",
              "ARCHIVED"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "sha256"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "target_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "accepted_head_sha",
          "branches"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "accepted_head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workspace_id",
                "branch",
                "head_sha",
                "worktree_path",
                "dirty",
                "semantic_status_sha256",
                "remote_url",
                "disposition",
                "evidence"
              ],
              "properties": {
                "branch": {
                  "type": "string",
                  "minLength": 1
                },
                "head_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "worktree_path": {
                  "type": "string",
                  "minLength": 1
                },
                "dirty": {
                  "type": "boolean"
                },
                "semantic_status_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "remote_url": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "ACCEPTED_HEAD",
                    "UNMUTATED_HISTORICAL",
                    "SUPERSEDED_PRESERVED",
                    "REJECTED_PRESERVED"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ref",
                      "sha256"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                },
                "workspace_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._/-]+$"
                }
              }
            },
            "minItems": 1
          }
        }
      }
    },
    "historical_material": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256",
          "disposition",
          "supersession_ref",
          "supersession_sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "disposition": {
            "enum": [
              "HISTORICAL_NON_AUTHORITATIVE",
              "SUPERSEDED_EVIDENCE"
            ]
          },
          "supersession_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersession_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "successor_authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "successor_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "closure_ready": {
      "const": true
    }
  }
}
