{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"flyby/mission-control/core-mutation-contract-v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","contract_id","cell_id","target_base","objective","discovery_evidence_refs","existing_substrates","change_obligations","preservation_obligations","non_goals","owned_write_scope","prohibited_scope","applicable_target_requirements","acceptance","negative_tests","verification","conflict_class"],
