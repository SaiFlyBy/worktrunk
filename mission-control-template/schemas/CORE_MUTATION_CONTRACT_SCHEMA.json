    "acceptance":{"type":"array","minItems":1,"items":{"type":"string"}},
    "negative_tests":{"type":"array","minItems":1,"items":{"type":"string"}},
    "verification":{"type":"array","minItems":1,"items":{"type":"string"}},
    "conflict_class":{"type":"string"},
    "integration_notes":{"type":"array","items":{"type":"string"}}
  }
}