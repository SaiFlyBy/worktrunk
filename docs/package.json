{
  "name": "worktrunk-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/astro.mjs build --force",
    "check": "node scripts/astro.mjs check",
    "dev": "node scripts/astro.mjs dev --force",
    "parity": "node scripts/parity.mjs",
    "preview": "node scripts/astro.mjs preview",
    "test": "node --test tests/plugins.test.mjs tests/telemetry.test.mjs",
    "test:site": "node --test tests/built-site.test.mjs tests/browser-site.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
